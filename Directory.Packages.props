<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ── Microsoft.Extensions.* → 10.0.8 ── -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <!-- ── System.* → 10.0.8 ── -->
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
    <PackageVersion Include="System.DirectoryServices" Version="10.0.8" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.8" />
    <PackageVersion Include="System.IO.Packaging" Version="10.0.8" />
    <PackageVersion Include="System.Management" Version="10.0.8" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.8" />
    <PackageVersion Include="System.Net.Http.WinHttpHandler" Version="10.0.8" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.8" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.8" />
    <!-- ── System.ServiceModel (WCF CoreFX) ── -->
    <PackageVersion Include="System.ServiceModel.Duplex" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.Security" Version="6.0.0" />
    <!-- ── Microsoft.Bcl → 10.0.8 ── -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.8" />
    <!-- ── Microsoft.IdentityModel.* → 8.19.2 (must match ExchangeOnlineManagement 3.10.1's vendored netCore assemblies, or Connect-ExchangeOnline throws FileLoadException 0x80131040 loading its private copy into the same AssemblyLoadContext) ── -->
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Validators" Version="8.19.2" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <!-- ── Azure SDK ── -->
    <PackageVersion Include="Azure.Core" Version="1.57.0" />
    <!-- ── Microsoft.Graph ── -->
    <PackageVersion Include="Microsoft.Graph.Beta" Version="5.99.0-preview" />
    <PackageVersion Include="Microsoft.Graph.Core" Version="3.2.3" />
    <!-- ── Microsoft.Kiota.* (keep current; aligned to Graph v5) ── -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageVersion Include="Microsoft.Kiota.Authentication.Azure" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Form" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Json" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Multipart" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Text" Version="1.22.0" />
    <!-- ── Newtonsoft.Json ── -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- ── JSON schema validation (MIT) ── -->
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <!-- ── Third-party misc ── -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.1" />
    <PackageVersion Include="Std.UriTemplate" Version="2.0.8" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>
</Project>
